NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/ticketing_system

JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ─────────────────────────────────────────────────────────────────────────────
# Email — Resend API
# Get your free API key at https://resend.com → API Keys
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# From address:
#   • Development : onboarding@resend.dev  (no domain verification required)
#   • Production  : Your verified domain   e.g. support@yourdomain.com
EMAIL_FROM="BitMax Support <onboarding@resend.dev>"
