NODE_ENV=development
PORT=5000
# Comma-separated frontend origins allowed to call the backend.
CLIENT_URL=http://localhost:5173
# Set false when frontend is hosted separately from the API.
SERVE_FRONTEND=false

MONGO_URI=mongodb://127.0.0.1:27017/ticketing_system

JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=20

# Email provider: "apps_script" uses the Apps Script web app for Gmail send + inbox polling.
# The default "smtp" provider uses Gmail SMTP and an App Password.
EMAIL_PROVIDER=smtp
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM="BitMax Support <you@gmail.com>"

# Used only by the SMTP provider. Apps Script provider disables this poller automatically.
GMAIL_IMAP_ENABLED=true
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_POLL_INTERVAL_MS=60000
