{
  "info": {
    "name": "BitMax Full-Stack Ticketing & Email Support API",
    "_postman_id": "b34e5a90-8821-4f91-a189-9b4317c2f821",
    "description": "Production REST API collection for BitMax MERN Ticketing & Email Support System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "ticketId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Cooper\",\n  \"email\": \"alice@example.com\",\n  \"phone\": \"+91 9876543210\",\n  \"password\": \"Password123!\",\n  \"role\": \"customer\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"otp\": \"123456\",\n  \"type\": \"register\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["auth", "verify-otp"] }
          }
        },
        {
          "name": "Login (Password)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bitmax.local\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login-password", "host": ["{{baseUrl}}"], "path": ["auth", "login-password"] }
          }
        },
        {
          "name": "Request Login OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login-otp", "host": ["{{baseUrl}}"], "path": ["auth", "login-otp"] }
          }
        },
        {
          "name": "Verify Login OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/verify-login-otp", "host": ["{{baseUrl}}"], "path": ["auth", "verify-login-otp"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["auth", "refresh-token"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "List Tickets",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/tickets?page=1&limit=10&status=&priority=&category=&view=all",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "" },
                { "key": "priority", "value": "" },
                { "key": "category", "value": "" },
                { "key": "view", "value": "all" }
              ]
            }
          }
        },
        {
          "name": "Create Ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"High latency observed in API gateway\",\n  \"description\": \"Latency spikes up to 1200ms during the evening rush hour.\",\n  \"category\": \"Technical Support\",\n  \"priority\": \"high\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/tickets", "host": ["{{baseUrl}}"], "path": ["tickets"] }
          }
        },
        {
          "name": "Get Ticket Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}"] }
          }
        },
        {
          "name": "Reply to Ticket (Public)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"We have analyzed the gateway logs and deployed a scaling patch.\",\n  \"type\": \"public\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}messages", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "messages"] }
          }
        },
        {
          "name": "Add Internal Note (Agent/Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Internal note: AWS auto-scaling group min size bumped to 4.\",\n  \"type\": \"internal\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}messages", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "messages"] }
          }
        },
        {
          "name": "Assign Ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"agentId\": \"6ad860f965167becbefa7533\"\n}" },
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/assign", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "assign"] }
          }
        },
        {
          "name": "Resolve Ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Issue resolved in production release 2.4\"\n}" },
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/resolve", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "resolve"] }
          }
        },
        {
          "name": "Reopen Ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Latency resumed after 1 hour\"\n}" },
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/reopen", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "reopen"] }
          }
        },
        {
          "name": "Close Ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Confirmed resolved with client\"\n}" },
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/close", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "close"] }
          }
        },
        {
          "name": "Get Activity Timeline",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/activity", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "activity"] }
          }
        }
      ]
    },
    {
      "name": "Email Inbound Webhook",
      "item": [
        {
          "name": "Inbound Email Webhook (Two-Way Synchronization)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"john.doe@example.com\",\n  \"senderName\": \"John Doe\",\n  \"to\": \"support+TKT-2026-000001@bitmax.local\",\n  \"subject\": \"Re: [TKT-2026-000001] Production Database Timeout\",\n  \"body\": \"Replying directly from my email client. The latency has cleared up!\",\n  \"messageId\": \"<msg-sim-2026-abc@client.mail>\",\n  \"headers\": {\n    \"x-ticket-number\": \"TKT-2026-000001\",\n    \"references\": \"<ticket-TKT-2026-000001@bitmax.local>\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/email/inbound", "host": ["{{baseUrl}}"], "path": ["email", "inbound"] }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/summary", "host": ["{{baseUrl}}"], "path": ["dashboard", "summary"] }
          }
        }
      ]
    }
  ]
}
